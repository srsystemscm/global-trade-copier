.venv/
__pycache__/
*.pyc
hub/data/
hub/logs/
# Real credentials, in whatever shape a .env ends up saved as --
# .env.local, .env.bak-before-port, .env.save. The bare `.env` pattern
# matched that exact name and nothing else, so a backup sitting beside it
# showed as untracked rather than ignored: one `git add -A` from
# committing a live Flex token. The example file is the deliberate
# exception, and is tracked.
.env*
!.env.example
node_modules/
ui/dist/

# The Operations hub reporter's API key. Never in the repository --
# ODH_COPIER_KEY in the environment is the other way to supply it.
hub/config/hub_key.txt

# Built VPS packages. A release artefact, rebuilt from source on demand,
# and large enough that committing one would be noticed in every later diff.
dist/

# Compiled MQL4. The source is tracked and a terminal recompiles it in
# seconds; an .ex4 is whatever MetaEditor last produced on one machine.
tools/*.ex4

# The gate's unit list (tools/make_gate_list.py). A SNAPSHOT of which
# units were live when it ran -- committing one would have the next
# person fire a list that was true last month.
tools/gtc-gate-list.csv
