# Copy this file to `.env` and fill in the values you need. `.env` is
# git-ignored -- never commit real secrets. Every setting here is optional
# (sensible defaults live in app/config.py); only set what you're actually
# using. All vars are prefixed TC_ and loaded via pydantic-settings.
#
# Slave-specific config (MT4 host/port, Schwab account IDs, IBKR
# host/port/client_id, sizing, symbol maps, ATR periods) does NOT live
# here -- that's per-slave, stored in the `slaves` table (seeded from
# hub/config/slaves.json, or added live through the dashboard).

# --- Network ---
# TC_HTTP_PORT=8000
# TC_ZMQ_SUB_PORT=5555
# TC_ZMQ_PULL_PORT=5557
# TC_ZMQ_BIND_HOST=*

# --- Logging ---
# TC_LOG_LEVEL=INFO

# --- Schwab OAuth2 ---
# Register an app at https://developer.schwab.com to get these. The
# redirect_uri must exactly match what's registered there -- for a VPS
# deployment behind nginx/TLS this should be your public domain, e.g.
# https://copier.example.com/schwab/callback
TC_SCHWAB_CLIENT_ID=
TC_SCHWAB_CLIENT_SECRET=
TC_SCHWAB_REDIRECT_URI=https://127.0.0.1:8000/schwab/callback

# --- Email notifications (SMTP) ---
# Unset (TC_SMTP_HOST empty) means email notifications are silently
# skipped -- only the webhook (set via the Notifications settings tab,
# not here) fires. Any standard SMTP provider works (e.g. an app password
# from Gmail, or a transactional email service like SendGrid/Mailgun's
# SMTP relay).
# TC_SMTP_HOST=smtp.example.com
# TC_SMTP_PORT=587
# TC_SMTP_USER=
# TC_SMTP_PASSWORD=
# TC_SMTP_FROM=trade-copier@example.com

# --- Hardening tuning (Phase 5) ---
# Defaults are sane for production; lower the watchdog intervals only for
# local testing (see hub/README.md's Phase 5 verification section).
# TC_ADAPTER_MAX_RETRIES=3
# TC_ADAPTER_RETRY_BASE_DELAY=0.5
# TC_WATCHDOG_POLL_INTERVAL_SECONDS=15
# TC_WATCHDOG_STALE_HEARTBEAT_SECONDS=30
# TC_DRAWDOWN_ALERT_PCT=0.05
